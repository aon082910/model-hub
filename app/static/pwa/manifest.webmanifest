{
  "name": "Model Hub",
  "short_name": "Model Hub",
  "description": "Your self-hosted 3D print library",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#14161a",
  "theme_color": "#14161a",
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [ { "name": "file", "accept": [".stl", ".3mf", ".obj", ".step", ".stp", ".fbx", ".zip", "model/stl", "model/3mf", "model/obj", "application/zip", "application/octet-stream"] } ] }
  },
  "icons": [
    { "src": "/assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" }
  ]
}
